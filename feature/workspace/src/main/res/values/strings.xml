    <string name="workspace_spec_title">Quy cách tạo mẫu v1</string>
    <string name="workspace_spec_intro">Nén toàn bộ thư mục mẫu thành ZIP. Thư mục gốc ZIP có thể chứa trực tiếp template.json hoặc chỉ chứa một thư mục mẫu.</string>
    <string name="workspace_spec_min_structure">Cấu trúc tối thiểu</string>
    <string name="workspace_spec_min_structure_body">template.json\npreview.png (tùy chọn, 270×270)\nTệp dự án hoặc *.template\ntemplate-hooks/ (tùy chọn)</string>
    <string name="workspace_spec_manifest">Yêu cầu về tệp kê khai</string>
    <string name="workspace_spec_manifest_body">id chỉ được dùng chữ thường, chữ số, dấu chấm, gạch dưới và gạch ngang; builtin. là tiền tố dành riêng cho hệ thống. projectType hỗ trợ ANDROID, FLUTTER, GENERAL. category dùng để phân nhóm mẫu.</string>
    <string name="workspace_spec_variables">Biến và tệp</string>
    <string name="workspace_spec_variables_body">Tên và đường dẫn tạo dự án do Trí Phường điền thống nhất. Mẫu khai báo các trường động qua variables, hỗ trợ TEXT, MULTILINE, NUMBER, BOOLEAN, SELECT, SECRET. Nội dung và đường dẫn tệp có thể dùng {{variableName}}; mọi tệp văn bản đều có thể thêm hậu tố .template, hậu tố này sẽ bị bỏ khi tạo. Thư mục gói dùng TIANXUAN_PACKAGE_PATH. Biến bắt buộc ẩn phải có giá trị mặc định, ngoại trừ biến do hệ thống tạo ra.</string>
    <string name="workspace_spec_preview">Ảnh xem trước</string>
    <string name="workspace_spec_preview_body">Hỗ trợ PNG, JPEG, WebP, GIF; mỗi ảnh tối đa 4 MiB. Ảnh xem trước có tỷ lệ 1:1, kích thước bắt buộc 270×270 px.</string>
    <string name="workspace_spec_hooks">Script khởi tạo</string>
    <string name="workspace_spec_hooks_body">beforeCreate và afterCreate phải trỏ đến script trong template-hooks/. Script chỉ chạy khi người dùng cho phép rõ ràng lúc tạo dự án; script chạy trong thư mục dự án mới của sandbox Linux, tối đa 60 giây. Biến được truyền qua biến môi trường TIANXUAN_VAR_&lt;tên biến viết hoa&gt;, đường dẫn dự án là TIANXUAN_PROJECT_DIR.</string>
    <string name="workspace_spec_validation">Kiểm tra kết quả</string>
    <string name="workspace_spec_validation_body">validation có thể khai báo requiredFiles, forbiddenFiles và contentRules; đường dẫn và nội dung hỗ trợ biến mẫu. Việc kiểm tra diễn ra sau khi hoàn tất afterCreate.</string>
    <string name="workspace_spec_footer">Bạn có thể xuất bất kỳ mẫu tích hợp sẵn nào làm ví dụ đầy đủ; trước khi nhập, hãy đổi id và bỏ tiền tố builtin. dành riêng.</string>
