    <string name="workspace_spec_title">Quy chuẩn tạo mẫu v1</string>
    <string name="workspace_spec_intro">Nén toàn bộ thư mục mẫu thành ZIP. Thư mục gốc ZIP có thể đặt trực tiếp template.json, hoặc chỉ chứa một thư mục mẫu.</string>
    <string name="workspace_spec_min_structure">Cấu trúc tối thiểu</string>
    <string name="workspace_spec_min_structure_body">template.json\npreview.png (tùy chọn, 270×270)\nTệp dự án hoặc *.template\ntemplate-hooks/ (tùy chọn)</string>
    <string name="workspace_spec_manifest">Yêu cầu bản kê khai</string>
    <string name="workspace_spec_manifest_body">id chỉ được dùng chữ thường, số, dấu chấm, gạch dưới và gạch ngang; builtin. là tiền tố dành riêng cho hệ thống. projectType hỗ trợ ANDROID, FLUTTER, GENERAL. category dùng để nhóm mẫu.</string>
    <string name="workspace_spec_variables">Biến và tệp</string>
    <string name="workspace_spec_variables_body">Tên dự án và đường dẫn tạo do Trí Phường điền thống nhất. Mẫu khai báo trường động qua variables, hỗ trợ TEXT, MULTILINE, NUMBER, BOOLEAN, SELECT, SECRET. Nội dung và đường dẫn tệp có thể dùng {{variableName}}; bất kỳ tệp văn bản nào cũng có thể thêm hậu tố .template, hậu tố này sẽ bị xóa khi tạo. Thư mục gói dùng TIANXUAN_PACKAGE_PATH. Biến bắt buộc ẩn phải có giá trị mặc định, ngoại trừ biến phái sinh của hệ thống.</string>
    <string name="workspace_spec_preview">Ảnh xem trước</string>
    <string name="workspace_spec_preview_body">Hỗ trợ PNG, JPEG, WebP, GIF, mỗi ảnh không quá 4 MiB. Ảnh xem trước thống nhất tỷ lệ 1:1, kích thước phải là 270×270 px.</string>
    <string name="workspace_spec_hooks">Script tạo</string>
    <string name="workspace_spec_hooks_body">beforeCreate và afterCreate phải trỏ tới script dưới template-hooks/. Script chỉ thực thi khi người dùng cấp quyền rõ ràng lúc tạo công trình, chạy trong thư mục công trình mới của hộp cát Linux, tối đa 60 giây. Biến được truyền qua biến môi trường TIANXUAN_VAR_&lt;TÊN BIẾN VIẾT HOA&gt;, đường dẫn công trình là TIANXUAN_PROJECT_DIR.</string>
    <string name="workspace_spec_validation">Kiểm tra kết quả</string>
    <string name="workspace_spec_validation_body">validation có thể khai báo requiredFiles, forbiddenFiles và contentRules; đường dẫn và nội dung hỗ trợ biến mẫu. Việc kiểm tra được thực thi sau khi afterCreate hoàn tất.</string>
    <string name="workspace_spec_footer">Có thể xuất bất kỳ mẫu tích hợp sẵn nào làm ví dụ hoàn chỉnh trước; trước khi nhập cần sửa id và xóa tiền tố builtin. dành riêng.</string>
