    <string name="workspace_spec_title">Quy cách tạo mẫu v1</string>
    <string name="workspace_spec_intro">Nén toàn bộ thư mục mẫu thành ZIP. Thư mục gốc của ZIP có thể chứa trực tiếp template.json hoặc chỉ chứa một thư mục mẫu.</string>
    <string name="workspace_spec_min_structure">Cấu trúc tối thiểu</string>
    <string name="workspace_spec_min_structure_body">template.json\npreview.png (không bắt buộc, 270×270)\ntệp dự án hoặc *.template\ntemplate-hooks/ (không bắt buộc)</string>
    <string name="workspace_spec_manifest">Yêu cầu danh mục</string>
    <string name="workspace_spec_manifest_body">id chỉ chấp nhận chữ thường, chữ số, dấu chấm, gạch dưới và gạch ngang; builtin. là tiền tố dành riêng cho hệ thống. projectType hỗ trợ ANDROID, FLUTTER, GENERAL. category dùng để nhóm các mẫu.</string>
    <string name="workspace_spec_variables">Biến và tệp</string>
    <string name="workspace_spec_variables_body">Tên và đường dẫn dự án do Không gian điền. Mẫu khai báo trường động qua variables, hỗ trợ TEXT, MULTILINE, NUMBER, BOOLEAN, SELECT, SECRET. Nội dung và đường dẫn tệp có thể dùng {{variableName}}; tệp văn bản có thể thêm hậu tố .template và hậu tố này sẽ bị bỏ khi tạo. Thư mục gói dùng TIANXUAN_PACKAGE_PATH. Biến bắt buộc bị ẩn phải có giá trị mặc định, trừ biến do hệ thống suy ra.</string>
    <string name="workspace_spec_preview">Ảnh xem trước</string>
    <string name="workspace_spec_preview_body">Hỗ trợ PNG, JPEG, WebP, GIF, tối đa 4 MiB mỗi ảnh. Ảnh xem trước có tỷ lệ 1:1 và kích thước phải đúng 270×270 px.</string>
    <string name="workspace_spec_hooks">Tập lệnh hook</string>
    <string name="workspace_spec_hooks_body">beforeCreate và afterCreate phải trỏ tới tập lệnh trong template-hooks/. Chỉ chạy khi người dùng cấp quyền rõ ràng lúc tạo dự án, trong thư mục dự án mới của môi trường cô lập Linux, tối đa 60 giây. Biến được truyền qua biến môi trường TIANXUAN_VAR_&lt;UPPERCASE_NAME&gt;; đường dẫn dự án là TIANXUAN_PROJECT_DIR.</string>
    <string name="workspace_spec_validation">Xác minh kết quả</string>
    <string name="workspace_spec_validation_body">validation có thể khai báo requiredFiles, forbiddenFiles và contentRules; đường dẫn và nội dung hỗ trợ biến mẫu. Việc xác minh chạy sau khi afterCreate hoàn tất.</string>
    <string name="workspace_spec_footer">Có thể xuất bất kỳ mẫu tích hợp sẵn nào để làm ví dụ đầy đủ; đổi id và bỏ tiền tố dành riêng builtin. trước khi nhập.</string>
