    <string name="developer_text_0001" formatted="false">Khóa công khai Ed25519 (Base64)</string>
    <string name="developer_text_0002" formatted="false">Môi trường Linux đã khôi phục về trạng thái ban đầu, dự án trong workspace chưa bị xóa.</string>
