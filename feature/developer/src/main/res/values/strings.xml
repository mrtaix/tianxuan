    <string name="developer_text_0038" formatted="false">Dung lượng lưu trữ chiếm dụng</string>
    <string name="developer_text_0039" formatted="false">Sẽ xóa RootFS Linux hiện tại, các công cụ đã cài và bộ nhớ đệm sandbox, nhưng giữ lại dự án /workspace và bộ nhớ dùng chung của điện thoại. Thao tác này không thể hoàn tác.</string>
    <string name="developer_text_0040" formatted="false">Sẽ tải trực tuyến và kiểm tra phiên bản mới, giữ lại /root và /opt/tianxuan. Trong khi cập nhật, các tiến trình Linux nền sẽ dừng, khi thất bại sẽ tự động khôi phục phiên bản cũ.</string>
    <string name="developer_text_0041" formatted="false">Sẽ gỡ bỏ Runtime dùng chung không được công cụ nào tham chiếu, thao tác này không thể tự động khôi phục.</string>
