    <string name="developer_text_0027" formatted="false">Chỉ xóa các tệp tải xuống chưa kích hoạt và tệp tạm, không ảnh hưởng đến hệ thống Linux, công cụ hay workspace.</string>
    <string name="developer_text_0028" formatted="false">Runtime có thể dọn dẹp</string>
    <string name="developer_text_0029" formatted="false">Tiến trình Linux nền và dung lượng đĩa chiếm dụng</string>
    <string name="developer_text_0030" formatted="false">Tiến trình nền</string>
    <string name="developer_text_0031" formatted="false">Không</string>
    <string name="developer_text_0032" formatted="false">Lệnh không được để trống.</string>
    <string name="developer_text_0033" formatted="false">Chẩn đoán lệnh</string>
    <string name="developer_text_0034" formatted="false">Thực thi lệnh Shell một lần trong môi trường Linux biệt lập</string>
    <string name="developer_text_0035" formatted="false">Sao chép</string>
