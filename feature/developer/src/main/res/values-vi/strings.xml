<resources>
    <string name="developer_text_0001" formatted="false">Khóa công khai Ed25519 (Base64)</string>
    <string name="developer_text_0002" formatted="false">Môi trường Linux đã được khôi phục về trạng thái ban đầu. Dự án trong không gian làm việc không bị xóa.</string>
    <string name="developer_text_0003" formatted="false">Không đặt lại được môi trường Linux</string>
    <string name="developer_text_0004" formatted="false">RootFS đã là phiên bản mới nhất.</string>
    <string name="developer_text_0005" formatted="false">Đã cập nhật RootFS và giữ nguyên dữ liệu người dùng.</string>
    <string name="developer_text_0006" formatted="false">Không khởi tạo được môi trường thực thi</string>
    <string name="developer_text_0007" formatted="false">Đã kiểm tra các khả năng cốt lõi của môi trường thực thi</string>
    <string name="developer_text_0008" formatted="false">Lệnh trình vỏ</string>
