    <string name="developer_text_0020" formatted="false">Tạo không gian làm việc</string>
    <string name="developer_text_0021" formatted="false">Tạo thư mục thực thi</string>
    <string name="developer_text_0022" formatted="false">Đang khởi tạo</string>
    <string name="developer_text_0023" formatted="false">Đã khởi tạo.</string>
    <string name="developer_text_0024" formatted="false">Làm mới</string>
    <string name="developer_text_0025" formatted="false">Hủy</string>
    <string name="developer_text_0026" formatted="false">Hủy tải xuống</string>
    <string name="developer_text_0027" formatted="false">Chỉ xóa các bản tải xuống không còn hoạt động và tệp tạm, không ảnh hưởng đến hệ thống Linux, công cụ hay không gian làm việc.</string>
    <string name="developer_text_0028" formatted="false">Môi trường thực thi có thể dọn</string>
    <string name="developer_text_0029" formatted="false">Tiến trình Linux nền và dung lượng đĩa sử dụng</string>
    <string name="developer_text_0030" formatted="false">Tiến trình nền</string>
    <string name="developer_text_0031" formatted="false">Không</string>
    <string name="developer_text_0032" formatted="false">Lệnh không được để trống.</string>
    <string name="developer_text_0033" formatted="false">Chẩn đoán bằng lệnh</string>
    <string name="developer_text_0034" formatted="false">Chạy lệnh trình vỏ một lần trong môi trường Linux cô lập</string>
    <string name="developer_text_0035" formatted="false">Sao chép</string>
    <string name="developer_text_0036" formatted="false">Sao chép tất cả</string>
    <string name="developer_text_0037" formatted="false">Thất bại</string>
    <string name="developer_text_0038" formatted="false">Dung lượng sử dụng</string>
    <string name="developer_text_0039" formatted="false">Sẽ xóa RootFS Linux hiện tại, các công cụ đã cài và bộ nhớ đệm của môi trường cô lập, nhưng giữ nguyên dự án trong /workspace và bộ nhớ dùng chung của điện thoại. Không thể hoàn tác.</string>
    <string name="developer_text_0040" formatted="false">Sẽ tải và xác minh phiên bản mới qua mạng, giữ nguyên /root và /opt/tianxuan. Các tiến trình Linux nền sẽ dừng trong lúc cập nhật. Nếu thất bại, phiên bản cũ sẽ tự động được khôi phục.</string>
    <string name="developer_text_0041" formatted="false">Sẽ xóa các môi trường thực thi dùng chung không được công cụ nào tham chiếu. Không thể tự động khôi phục thao tác này.</string>
    <string name="developer_text_0042" formatted="false">Không gian làm việc</string>
    <string name="developer_text_0043" formatted="false">Không gian làm việc có thể ghi</string>
    <string name="developer_text_0044" formatted="false">Dữ liệu công cụ</string>
    <string name="developer_text_0045" formatted="false">Đã lưu cấu hình danh mục công cụ.</string>
    <string name="developer_text_0046" formatted="false">Nguồn công cụ</string>
    <string name="developer_text_0047" formatted="false">Tệp thực thi công cụ</string>
    <string name="developer_text_0048" formatted="false">Đã tắt (không ghi tệp nhật ký cục bộ)</string>
    <string name="developer_text_0049" formatted="false">Sẵn sàng</string>
    <string name="developer_text_0050" formatted="false">Đã là bản mới nhất</string>
    <string name="developer_text_0051" formatted="false">Bảng điều khiển nhà phát triển</string>
    <string name="developer_text_0052" formatted="false">Bất thường</string>
    <string name="developer_text_0053" formatted="false">Số lượt tham chiếu bằng 0</string>
    <string name="developer_text_0054" formatted="false">Hiện không có môi trường thực thi dùng chung nào có thể dọn an toàn.</string>
    <string name="developer_text_0055" formatted="false">Hiện không có tiến trình nền nào được đăng ký.</string>
    <string name="developer_text_0056" formatted="false">Khôi phục Linux về trạng thái ban đầu</string>
    <string name="developer_text_0057" formatted="false">Khôi phục Linux về trạng thái ban đầu?</string>
    <string name="developer_text_0058" formatted="false">Chạy lệnh</string>
    <string name="developer_text_0059" formatted="false">Lưu ý: người kiểm soát địa chỉ danh mục cũng có thể cung cấp khóa công khai. Khóa tự nhập chỉ giúp phát hiện dữ liệu hỏng khi truyền và xác minh tính nhất quán, không bảo đảm chống sửa đổi đầu cuối. Để có điểm neo tin cậy thực sự, hãy nhúng khóa công khai cố định trong APK.</string>
    <string name="developer_text_0060" formatted="false">Đã sao chép nhật ký</string>
    <string name="developer_text_0061" formatted="false">Đã sao chép nhật ký vào bộ nhớ tạm</string>
    <string name="developer_text_0062" formatted="false">Có</string>
    <string name="developer_text_0063" formatted="false">Lưu cục bộ luồng thực thi tác nhân, lệnh gọi công cụ và chi tiết lỗi</string>
    <string name="developer_text_0064" formatted="false">Đã xóa nhật ký tác nhân.</string>
    <string name="developer_text_0065" formatted="false">Nhật ký gỡ lỗi cục bộ của tác nhân</string>
    <string name="developer_text_0066" formatted="false">Chẩn đoán tác nhân</string>
    <string name="developer_text_0067" formatted="false">Chưa có nhật ký</string>
